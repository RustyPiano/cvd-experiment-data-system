# =============================================================================
# CVD 实验数据采集系统 — 生产部署环境变量模板
# 使用方法：
#   1. cp .env.production.example .env
#   2. 修改所有 YOUR_* 占位符
#   3. 部署: ./deploy.sh
# =============================================================================

# --- 应用配置 ---
APP_NAME=CVD Backend
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
EXPERIMENT_TIMEZONE=Asia/Shanghai

# --- 数据库（共享 1Panel PostgreSQL） ---
# URL 中的密码必须按 URI 规则编码；不要提交真实凭据。
COMPOSE_DATABASE_URL=postgresql+psycopg://YOUR_1PANEL_POSTGRES_USER:YOUR_URL_ENCODED_DB_PASSWORD@YOUR_1PANEL_POSTGRES_CONTAINER:5432/cvd
# deploy.sh / backup.sh 通过容器内 psql/pg_dump 做守卫与备份。
# 以下三项必须指向同一个目标；脚本会逐项核对其与 URL 的主机、用户和数据库。
PG_CONTAINER=YOUR_1PANEL_POSTGRES_CONTAINER
POSTGRES_DB=cvd
POSTGRES_USER=YOUR_1PANEL_POSTGRES_USER

# --- JWT 密钥（必须生成唯一随机值；占位符或短于 32 字符会拒绝启动） ---
# 生成命令：openssl rand -hex 32
JWT_SECRET_KEY=YOUR_RANDOM_JWT_SECRET_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- 内部注册邀请码 ---
# 留空即关闭自助注册；启用时填写 8–128 字符的非占位值。
REGISTRATION_INVITE_CODE=

# --- 文件上传 ---
FILE_UPLOAD_MAX_BYTES=52428800
# Docker Compose 内部存储路径，不需要改
COMPOSE_FILE_STORAGE_ROOT=/data/storage

# --- CORS 允许来源 ---
# Docker Compose 部署时前端和后端通过 nginx 同源访问，通常不需要额外配置。
# 如果后端直接暴露端口对外服务，请添加服务器 IP/主机名：
# CORS_ALLOW_ORIGINS=http://your-server-ip:5173,http://your-server-hostname:5173
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 前端配置 ---
# Docker Compose 默认通过 nginx 同源 /api 代理，设为 / 即可
VITE_API_BASE_URL=/
# 对外访问端口（默认 80）
FRONTEND_PORT=80
BACKEND_PORT=8000

# =============================================================================
# 部署后还需手动执行：
#   docker compose -f docker-compose.prod.yml exec backend \
#     uv run python -m app.commands.create_admin --email <admin-email> --name <admin-name>
# =============================================================================
